# URL del servidor de senalizacion (ws:// en LAN, wss:// tras TLS)
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080   # en prod: wss://api.vela.stellaria.app
# Token compartido con el servidor (VELA_TOKEN). Llega al bundle del navegador:
# protege el acceso al dashboard aparte.
NEXT_PUBLIC_SIGNALING_TOKEN=cambia-este-token
